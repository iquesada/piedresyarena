---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TripTiles from '../components/TripTiles.astro';
import { t } from '../i18n';

const page = (await getEntry('pages', 'es/sobre-mi'))!;
const { Content } = await render(page);
const { title, image, seoTitle, seoDescription } = page.data;
const locale = Astro.currentLocale;
---
<Base title={title} seoTitle={seoTitle} description={seoDescription} overlay={Boolean(image)}>
  {image ? (
    <header class="opener">
      <Image src={image} alt="" widths={[480, 760, 1080, 1600]} sizes="100vw" priority />
      <div class="opener-text"><h1 class="display">{title}</h1></div>
    </header>
  ) : (
    <h1 class="display plain">{title}</h1>
  )}

  <article class="prose body" data-strip-labels={JSON.stringify([t(locale, 'gallery.prev'), t(locale, 'gallery.next')])}>
    <Content />
  </article>

  <section class="trips">
    <h2 class="display">{t(locale, 'trips.label')}</h2>
    <TripTiles />
  </section>
</Base>

<script>
  // Prev/next buttons for photo strips; swiping and scrolling work without them.
  const article = document.querySelector<HTMLElement>('[data-strip-labels]')!;
  const [prev, next] = JSON.parse(article.dataset.stripLabels!) as [string, string];
  const smooth = window.matchMedia('(prefers-reduced-motion: no-preference)').matches ? 'smooth' : 'auto';
  for (const strip of article.querySelectorAll<HTMLElement>('.gallery.strip')) {
    const controls = document.createElement('div');
    controls.className = 'strip-controls';
    for (const [label, dir] of [[prev, -1], [next, 1]] as const) {
      const button = document.createElement('button');
      button.type = 'button';
      button.setAttribute('aria-label', label);
      button.textContent = dir < 0 ? '←' : '→';
      button.addEventListener('click', () => {
        const step = strip.querySelector('p')?.getBoundingClientRect().width ?? strip.clientWidth;
        strip.scrollBy({ left: dir * (step + 4), behavior: smooth });
      });
      controls.append(button);
    }
    strip.after(controls);
  }
</script>

<style>
  .opener { height: 85svh; min-height: 28rem; max-height: 52rem; }
  .opener h1 { font-size: clamp(3.5rem, 16vw, 9rem); }
  .plain { font-size: clamp(3.5rem, 16vw, 8rem); max-width: var(--wide); margin: 2.5rem auto 0; padding: 0 1.1rem; }
  article { padding: 2.5rem 1.1rem 1rem; }
  .body > :global(p:first-child::first-letter) {
    float: left; font-family: var(--display); font-weight: 850; font-stretch: 62%; font-size: 4.6em; line-height: 0.8; padding: 0.06em 0.08em 0 0;
  }
  .trips { margin-top: 3rem; background: var(--night); color: var(--white); padding-top: 2.5rem; }
  .trips h2 { font-size: clamp(2.5rem, 11vw, 5rem); padding: 0 1.1rem 1.25rem; }
</style>
