---
import { getCollection } from 'astro:content';
import TripPage from '../../../components/TripPage.astro';
import { allStages, stagesOf, tripPath } from '../../../lib/content';

export async function getStaticPaths() {
  const trips = await getCollection('trips');
  const translated = new Set((await allStages('en')).map((s) => s.data.trip.id));
  const withStages = await Promise.all(trips.map(async (trip) => ({ trip, stages: await stagesOf('es', trip.id) })));
  return withStages
    .filter(({ stages }) => stages.length > 0)
    .map(({ trip, stages }) => ({
      params: { trip: trip.id },
      props: { trip, stages, alternate: translated.has(trip.id) ? tripPath('en', trip) : undefined },
    }));
}
---
<TripPage {...Astro.props} />
