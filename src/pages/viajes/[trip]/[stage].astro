---
import StagePage from '../../../components/StagePage.astro';
import { allStages, stagePath } from '../../../lib/content';

export async function getStaticPaths() {
  const english = new Map((await allStages('en')).map((s) => [s.key, s]));
  return (await allStages('es')).map((stage) => {
    const alternate = english.get(stage.key);
    return { params: { trip: stage.data.trip.id, stage: stage.slug }, props: { stage, alternate: alternate && stagePath(alternate) } };
  });
}
---
<StagePage {...Astro.props} />
