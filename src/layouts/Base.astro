---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import LogoIcon from '../components/LogoIcon.astro';
import InstagramLink from '../components/InstagramLink.astro';
import { englishPublic, t, toLocale } from '../i18n';
import { aboutPath, homePath } from '../lib/content';

interface Props {
  title?: string;
  seoTitle?: string;
  description?: string;
  noCanonical?: boolean;
  /** The page opens with a full-bleed photo: the header is drawn over it. */
  overlay?: boolean;
  /** Dark page background (the home page and trip pages). */
  dark?: boolean;
  /** URL of this page in the other language, if it has one. */
  alternate?: string;
}

const { title, seoTitle, description, noCanonical, overlay = false, dark = false, alternate } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const other = locale === 'es' ? 'en' : 'es';
const site = t(locale, 'site.title');
const wordmark = site.replaceAll(' ', ''); // written as one word, like the original logo
const fullTitle = seoTitle ?? (title ? `${title} | ${site}` : site);
const canonical = new URL(Astro.url.pathname, Astro.site);
// Switcher and hreflang stay hidden until English is public.
const switchTo = englishPublic ? alternate : undefined;
const versions = switchTo && { [locale]: canonical, [other]: new URL(switchTo, Astro.site) };
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description || t(locale, 'site.description')} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    {versions && ['es', 'en'].map((l) => <link rel="alternate" hreflang={l} href={versions[l]} />)}
    {versions && <link rel="alternate" hreflang="x-default" href={versions.es} />}
    {locale === 'en' && !englishPublic && <meta name="robots" content="noindex" />}
  </head>
  <body class:list={{ dark }}>
    <header class:list={['bar', { overlay }]}>
      <a href={homePath(locale)} class="brand"><LogoIcon /><span>{wordmark}</span></a>
      <nav>
        <a href={homePath(locale)}>{t(locale, 'nav.trips')}</a>
        <a href={aboutPath(locale)}>{t(locale, 'nav.about')}</a>
        {switchTo && <a href={switchTo} hreflang={other} lang={other} aria-label={t(other, 'lang.switch')}>{other.toUpperCase()}</a>}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href={homePath(locale)} class="brand"><LogoIcon /><span>{wordmark}</span></a>
      <p>{t(locale, 'site.description')}</p>
      <InstagramLink />
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --white: #ffffff;
    --black: #000000;
    --stone: #77736b;
    --sand: #f0e887;
    --khaki: #cfccaa;
    --night: #1a1a17;
    --display: 'Archivo Variable', 'Arial Narrow', sans-serif;
    --serif: 'Source Serif 4 Variable', Georgia, serif;
    --measure: 48rem; /* about 90 characters of body text */
    --wide: 64rem; /* figures break out to this width: keep in sync with sizes in astro.config.mjs */
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--white); color: var(--black); font: 1.1875rem/1.65 var(--serif); font-optical-sizing: auto; }
  body.dark { background: var(--night); color: var(--white); }
  a { color: inherit; }
  a:focus-visible { outline: 3px solid var(--sand); outline-offset: 2px; }
  h1, h2, h3 { font-family: var(--display); line-height: 0.95; margin: 0; }

  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.9rem 1.1rem; background: var(--night); color: var(--white); font-family: var(--display);
  }
  .bar.overlay { position: absolute; inset: 0 0 auto; z-index: 1000; background: linear-gradient(rgb(0 0 0 / 0.55), transparent); }
  .brand {
    display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none;
    font-family: var(--display); font-weight: 800; font-stretch: 112%; font-size: 1.05rem; letter-spacing: 0.02em; text-transform: uppercase;
  }
  .bar nav { display: flex; gap: 1.2rem; font-weight: 600; font-stretch: 90%; font-size: 1rem; }
  .bar nav a { text-decoration: none; }
  .bar nav a:hover { color: var(--sand); }
  footer { background: var(--night); color: var(--khaki); padding: 3rem 1.1rem; display: grid; gap: 0.5rem; justify-items: start; }
  footer .brand { color: var(--white); }
  footer p { margin: 0; font-size: 1rem; }

  /* Full-bleed photo opening of trip and stage pages, and the photo tiles. */
  .opener { position: relative; overflow: hidden; color: var(--white); background: var(--black); }
  .opener > img, .tile > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; max-width: none; }
  .opener::after, .tile::after { content: ''; position: absolute; inset: 40% 0 0; background: linear-gradient(transparent, rgb(0 0 0 / 0.78)); }
  .opener-text, .tile-text { position: absolute; z-index: 1; inset: auto 0 0; padding: 1rem 1.1rem 1.25rem; }
  .opener-text { padding-bottom: 2.25rem; }
  .kicker { margin: 0 0 0.6rem; font-family: var(--display); font-weight: 600; font-size: 1rem; color: var(--sand); display: flex; align-items: center; gap: 0.5rem; }
  .kicker a { text-decoration: none; }
  .dot { flex: none; width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 2px rgb(255 255 255 / 0.85); }
  .display { font-weight: 850; font-stretch: 62%; text-transform: uppercase; }
  .tile { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; color: var(--white); text-decoration: none; background: var(--black); }
  .tile > img { transition: transform 0.6s ease; }
  .tile:hover > img { transform: scale(1.03); }
  .tile:focus-visible { outline-offset: -4px; }
  .tile h2 { font-size: clamp(2rem, 9vw, 3.25rem); font-weight: 800; font-stretch: 66%; text-transform: uppercase; }
  .tile p { margin: 0.4rem 0 0; font-size: 1rem; }
  .tiles { list-style: none; margin: 0; padding: 4px 0; display: grid; gap: 4px; }
  @media (prefers-reduced-motion: reduce) { .tile > img { transition: none; } }
  @media (min-width: 900px) {
    .tiles { grid-template-columns: 1fr 1fr; }
    .tile { aspect-ratio: 4 / 3; }
  }

  /* Long-form text: stages and standalone pages. */
  .prose { max-width: var(--measure); margin: 0 auto; }
  .prose p { margin: 0 0 1.2em; }
  .prose a { text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .prose figure { margin: 2.5rem -1.1rem; }
  .prose figure img { display: block; width: 100%; height: auto; }
  .prose figcaption { font-family: var(--display); font-size: 0.9rem; color: var(--stone); padding: 0.5rem 1.1rem 0; }
  .prose .embed { margin: 2rem -1.1rem; }
  .prose .embed iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }
  .prose .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin: 2rem -1.1rem; }
  .prose .gallery p { margin: 0; }
  .prose .gallery img { display: block; width: 100%; height: 100%; aspect-ratio: 1; object-fit: cover; }
  .prose blockquote {
    margin: 2.5rem 0; padding: 0; font-style: italic; font-size: clamp(1.75rem, 6vw, 2.6rem); line-height: 1.15;
  }
  .prose blockquote p { margin: 0; }
  .prose blockquote p::before { content: '«'; }
  .prose blockquote p::after { content: '»'; }
  /* A gallery marked `strip` is a row of large photos scrolled sideways. */
  .prose .gallery.strip {
    display: flex; gap: 4px; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    margin-bottom: 0.75rem; scrollbar-width: thin;
  }
  .prose .gallery.strip p { flex: 0 0 min(85%, 40rem); scroll-snap-align: center; }
  .prose .gallery.strip img { aspect-ratio: 4 / 3; }
  .strip-controls { display: flex; justify-content: flex-end; gap: 0.5rem; margin-bottom: 2rem; }
  .strip-controls button {
    width: 2.75rem; height: 2.75rem; border: 2px solid var(--black); background: none; color: var(--black);
    font: 600 1.25rem var(--display); cursor: pointer;
  }
  .strip-controls button:hover { background: var(--black); color: var(--white); }
  .strip-controls button:focus-visible { outline: 3px solid var(--sand); outline-offset: 2px; }
  @media (min-width: 760px) {
    .prose blockquote { margin-inline: -3rem; }
    .prose figure, .prose .gallery { margin-inline: calc((min(100vw, var(--wide)) - var(--measure)) / -2); }
    .prose .gallery { grid-template-columns: repeat(4, 1fr); }
    .prose figcaption { padding-inline: 0; max-width: var(--measure); margin: 0 auto; }
  }
</style>
