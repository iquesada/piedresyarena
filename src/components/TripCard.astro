---
import { Image } from 'astro:assets';
import { stageCount } from '../i18n';
import { stagesOf, tripPath, type Trip } from '../lib/content';

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;
const stages = await stagesOf(trip.id); // never empty: index.astro skips trips without stages
const locale = Astro.currentLocale;
---
<a class="card" href={tripPath(trip)}>
  <Image
    src={stages[0].data.image}
    alt=""
    width={480}
    height={320}
    sizes="(min-width: 1120px) 352px, (min-width: 640px) 50vw, 100vw"
  />
  <h2><span class="dot" style={`background: ${trip.data.color}`}></span>{trip.data.name}</h2>
  <p class="meta">{trip.data.country} · {trip.data.year} · {stageCount(locale, stages.length)}</p>
</a>

<style>
  .card { display: block; color: inherit; text-decoration: none; }
  .card h2 { font-size: 1.2rem; margin: 0.5rem 0 0; }
  .card p { margin: 0.25rem 0 0; }
  .card:hover h2 { color: var(--accent); }
  .dot { display: inline-block; width: 0.7em; height: 0.7em; border-radius: 50%; margin-right: 0.4em; }
</style>
