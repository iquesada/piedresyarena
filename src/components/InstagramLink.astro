---
import { t } from '../i18n';

const handle = 'piedresybarro';
const locale = Astro.currentLocale;
---
<a href={`https://instagram.com/${handle}`} class="instagram" rel="me noopener" target="_blank" aria-label={`${t(locale, 'social.instagram')}: @${handle}`}>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" />
  </svg>
  <span>@{handle}</span>
</a>

<style>
  .instagram {
    display: inline-flex; align-items: center; gap: 0.45rem; text-decoration: none;
    font-family: var(--display); font-weight: 600; font-size: 1rem;
  }
  .instagram:hover { color: var(--sand); }
  svg { width: 1.25em; height: 1.25em; flex: none; }
</style>
