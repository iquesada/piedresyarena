---
import Map from './Map.astro';
import { t, toLocale } from '../i18n';
import { allStages } from '../lib/content';

const locale = toLocale(Astro.currentLocale);
const stages = await allStages(locale);
const trips = new Set(stages.map((s) => s.data.trip.id)).size;
---
<section class="atlas">
  <Map overlay="atlas-title" />
  <div class="atlas-title" id="atlas-title">
    <h1 class="display">{t(locale, 'home.title')}</h1>
    <p>{t(locale, 'home.summary', { trips, stages: stages.length })}</p>
  </div>
</section>

<style>
  .atlas { position: relative; }
  /* Phones: the title sits below the map, so swiping on it scrolls the page. Wide screens: a box over the map. */
  .atlas :global(#map) { height: 60svh; min-height: 22rem; margin: 0; background: #e9e9e4; }
  .atlas :global(.leaflet-tile-pane) { filter: grayscale(1) contrast(0.9) brightness(1.06); }
  .atlas-title { padding: 1.5rem 1.1rem 1.75rem; background: var(--night); }
  .atlas-title h1 { font-size: clamp(3rem, 13vw, 6rem); max-width: 11ch; }
  .atlas-title p { margin: 0.75rem 0 0; color: var(--khaki); max-width: 30rem; font-size: 1.05rem; }
  @media (min-width: 900px) {
    .atlas :global(#map) { height: 78svh; min-height: 28rem; max-height: 56rem; }
    .atlas-title { position: absolute; z-index: 500; left: 2rem; bottom: 2rem; width: min(40%, 30rem); padding: 1.75rem 2rem 2rem; }
  }
</style>
