---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { formatDate, t, toLocale } from '../i18n';
import { allStages, stagePath, tripPath, tripText } from '../lib/content';
import { tracks } from '../pages/tracks/[trip].json';

interface Props {
  /** id of an element that may be drawn over the map (bottom band or left column); markers are fitted around it. */
  overlay?: string;
}

const { overlay } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const stages = await allStages(locale);
const trips = await Promise.all(
  (await getCollection('trips')).map(async (trip) => ({
    name: tripText(locale, trip).name,
    url: tripPath(locale, trip),
    color: trip.data.color,
    tracks: trip.id in tracks ? `/tracks/${trip.id}.json` : undefined,
    stages: await Promise.all(
      stages
        .filter((s) => s.data.trip.id === trip.id)
        .map(async (s, i) => ({
          key: s.key,
          lat: s.data.lat,
          lng: s.data.lng,
          title: s.data.title,
          url: stagePath(s),
          n: t(locale, 'stage.number', { n: i + 1 }),
          date: formatDate(locale, s.data.date),
          thumb: (await getImage({ src: s.data.image, width: 480, height: 360, fit: 'cover', format: 'webp' })).src,
        })),
    ),
  })),
).then((all) => all.filter((trip) => trip.stages.length > 0));
---
<div
  id="map"
  role="region"
  aria-label={t(locale, 'map.label')}
  data-trips={JSON.stringify(trips)}
  data-attribution={t(locale, 'map.attribution')}
  data-overlay={overlay}
>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { RIDER_SVG } from '../lib/rider';

  type Stage = { key: string; lat: number; lng: number; title: string; url: string; n: string; date: string; thumb: string };
  /** tracks: URL of the trip's tracks file (src/pages/tracks), when some stage has one. */
  type Trip = { name: string; url: string; color: string; tracks?: string; stages: Stage[] };
  type Point = [number, number];

  /** Below this zoom each trip is one pin; from it on, each stage has its own. */
  const STAGES_ZOOM = 5;
  /** A trip line segment shorter than this on screen (px) gets no arrow: it would sit on the pins. */
  const ARROW_MIN_SEGMENT = 40;

  const el = document.getElementById('map')!;
  const trips: Trip[] = JSON.parse(el.dataset.trips!);
  const map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25 });
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 18,
    attribution: `<a href="https://www.openstreetmap.org/copyright">${el.dataset.attribution}</a>`,
  }).addTo(map);

  // The rider (src/lib/rider.ts) on a white tag pointing at the place.
  const pin = (color: string) =>
    L.divIcon({
      className: 'pin',
      iconSize: [46, 34],
      iconAnchor: [23, 34],
      popupAnchor: [0, -30],
      html: `<svg viewBox="0 0 46 34" width="46" height="34" aria-hidden="true">
        <path d="M4 1h38a3 3 0 0 1 3 3v20a3 3 0 0 1-3 3H28l-5 6-5-6H4a3 3 0 0 1-3-3V4a3 3 0 0 1 3-3z" fill="#fff" stroke="rgb(0 0 0 / .25)"/>
        <g transform="translate(3 2)" style="color:${color}">${RIDER_SVG}</g></svg>`,
    });

  // An arrowhead pointing right, turned by `angle` (radians, clockwise on screen).
  const arrow = (color: string, angle: number) =>
    L.divIcon({
      className: 'arrow',
      iconSize: [16, 16],
      html: `<svg viewBox="0 0 12 12" width="16" height="16" aria-hidden="true" style="color:${color};transform:rotate(${angle}rad)">
        <path d="M1 1l10 5-10 5 3-5z" fill="currentColor" stroke="#fff" stroke-width="1"/></svg>`,
    });

  // Space of the map covered by the overlay: a band along the bottom or a column on the left. Nothing when
  // the overlay is laid out outside the map (below it, on phones).
  function covered() {
    const overlay = el.dataset.overlay ? document.getElementById(el.dataset.overlay)?.getBoundingClientRect() : undefined;
    const box = el.getBoundingClientRect();
    if (!overlay || overlay.top >= box.bottom) return { left: 0, bottom: 0 };
    const left = overlay.width < box.width * 0.7 ? overlay.right - box.left : 0;
    const bottom = left ? 0 : box.bottom - overlay.top;
    return { left, bottom };
  }

  function fit(bounds: L.LatLngBounds) {
    const { left, bottom } = covered();
    // Pins are 46px wide and stand 34px above their point: keep them whole inside the map.
    map.fitBounds(bounds, { paddingTopLeft: [40 + left, 50], paddingBottomRight: [40, 20 + bottom], maxZoom: 9 });
  }

  // A stage popup is a small photo tile linking to the stage, built with DOM nodes (no HTML strings from content).
  function popupFor(trip: Trip, s: Stage): HTMLElement {
    const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) => {
      const node = document.createElement(tag);
      node.className = className;
      if (text) node.textContent = text;
      return node;
    };
    const link = make('a', 'pop');
    link.href = s.url;
    const img = make('img', 'pop-img');
    img.src = s.thumb;
    img.alt = '';
    img.loading = 'lazy';
    const kicker = make('span', 'pop-kicker');
    const dot = make('span', 'pop-dot');
    dot.style.setProperty('--c', trip.color);
    kicker.append(dot, `${trip.name}, ${s.n.toLowerCase()}`);
    const body = make('span', 'pop-body');
    body.append(kicker, make('span', 'pop-title', s.title), make('span', 'pop-date', s.date));
    link.append(img, body);
    return link;
  }

  const tripPins = L.layerGroup();
  const stagePins = L.layerGroup();
  // At stage zoom each stage is drawn as its track, the ride itself, when it has one. A stage without a track
  // keeps its piece of trip line: dashed, from its place to the next stage's (a stage place is where the stage
  // starts, so without a track the last stage's ride is not drawn). Arrows show the way on both.
  const tripLines = L.layerGroup();
  const trackLines = L.layerGroup().addTo(tripLines);
  const dashedLines = L.layerGroup().addTo(tripLines);
  const arrows = L.layerGroup().addTo(tripLines);
  /** Loaded tracks by stage key; trips whose tracks file was requested. */
  const loaded = new Map<string, Point[]>();
  const requested = new Set<Trip>();
  for (const trip of trips) {
    const icon = pin(trip.color);
    const points = trip.stages.map((s): Point => [s.lat, s.lng]);
    const bounds = L.latLngBounds(points);
    // A trip's pin zooms into its stages.
    L.marker(bounds.getCenter(), { icon, title: trip.name, alt: trip.name, riseOnHover: true })
      .on('click', () => fit(bounds))
      .addTo(tripPins);
    for (const s of trip.stages) {
      L.marker([s.lat, s.lng], { icon, title: s.title, alt: s.title, riseOnHover: true })
        .bindPopup(popupFor(trip, s), { className: 'popup', maxWidth: 240, minWidth: 240 })
        // Keep the open popup clear of the overlay.
        .on('popupopen', (e) => {
          const { left, bottom } = covered();
          Object.assign(e.popup.options, { autoPanPaddingTopLeft: [10 + left, 10], autoPanPaddingBottomRight: [10, 10 + bottom] });
        })
        .addTo(stagePins);
    }
  }

  // An arrow at `at`, pointing from a to b. Angles are taken on screen, where the map draws the line, so
  // they change with the zoom.
  function addArrow(color: string, at: L.Point, a: L.Point, b: L.Point) {
    L.marker(map.layerPointToLatLng(at), {
      icon: arrow(color, Math.atan2(b.y - a.y, b.x - a.x)),
      interactive: false,
      keyboard: false,
      zIndexOffset: -1000,
    }).addTo(arrows);
  }

  // Tracks where loaded, dashed trip line elsewhere; one arrow at the middle of each, pointing the way.
  function drawLines() {
    for (const layer of [trackLines, dashedLines, arrows]) layer.clearLayers();
    for (const trip of trips) {
      trip.stages.forEach((s, i) => {
        const track = loaded.get(s.key);
        if (track) {
          L.polyline(track, { color: trip.color, weight: 3, opacity: 0.85, interactive: false }).addTo(trackLines);
          const screen = track.map((p) => map.latLngToLayerPoint(p));
          const length = screen.slice(1).reduce((sum, p, j) => sum + p.distanceTo(screen[j]), 0);
          if (length < ARROW_MIN_SEGMENT) return;
          // The middle by distance on screen, on the segment that holds it.
          let done = 0;
          for (let j = 1; j < screen.length; j++) {
            const step = screen[j].distanceTo(screen[j - 1]);
            if (done + step >= length / 2) {
              const at = screen[j - 1].add(screen[j].subtract(screen[j - 1]).multiplyBy((length / 2 - done) / step));
              addArrow(trip.color, at, screen[j - 1], screen[j]);
              break;
            }
            done += step;
          }
          return;
        }
        const next = trip.stages[i + 1];
        if (!next) return;
        L.polyline([[s.lat, s.lng], [next.lat, next.lng]], { color: trip.color, weight: 3, opacity: 0.7, dashArray: '6 6', interactive: false }).addTo(dashedLines);
        const a = map.latLngToLayerPoint([s.lat, s.lng]);
        const b = map.latLngToLayerPoint([next.lat, next.lng]);
        if (a.distanceTo(b) >= ARROW_MIN_SEGMENT) addArrow(trip.color, a.add(b).divideBy(2), a, b);
      });
    }
  }

  // Tracks are fetched only for the trips in view at stage zoom, once.
  function loadTracks() {
    const view = map.getBounds();
    for (const trip of trips) {
      if (!trip.tracks || requested.has(trip)) continue;
      if (!view.intersects(L.latLngBounds(trip.stages.map((s): Point => [s.lat, s.lng])))) continue;
      requested.add(trip);
      fetch(trip.tracks)
        .then((r) => (r.ok ? r.json() : {}))
        .then((byStage: Record<string, Point[]>) => {
          for (const [key, track] of Object.entries(byStage)) loaded.set(key, track);
          if (map.getZoom() >= STAGES_ZOOM) drawLines();
        })
        .catch(() => requested.delete(trip)); // try again on the next move
    }
  }

  const showPins = () => {
    const detailed = map.getZoom() >= STAGES_ZOOM;
    for (const layer of detailed ? [tripPins] : [stagePins, tripLines]) layer.remove();
    for (const layer of detailed ? [stagePins, tripLines] : [tripPins]) layer.addTo(map);
    if (detailed) {
      drawLines();
      loadTracks();
    }
  };
  map.on('zoomend', showPins);
  map.on('moveend', () => map.getZoom() >= STAGES_ZOOM && loadTracks());
  fit(L.latLngBounds(trips.flatMap((trip) => trip.stages.map((s): [number, number] => [s.lat, s.lng]))));
  showPins();
</script>

<style>
  #map { height: min(60vh, 520px); margin-bottom: 2rem; }
  #map :global(.pin) { background: none; border: 0; filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.35)); }
  #map :global(.arrow) { background: none; border: 0; }
  #map :global(.arrow svg) { display: block; }

  /* Stage popups: a small photo tile with the text over the photo. */
  #map :global(.popup .leaflet-popup-content-wrapper) { padding: 0; border-radius: 0; overflow: hidden; }
  #map :global(.popup .leaflet-popup-content) { margin: 0; width: 240px !important; }
  #map :global(.popup .leaflet-popup-tip) { background: #000; }
  #map :global(.popup .leaflet-popup-close-button) { color: #fff; }
  #map :global(.pop) { position: relative; display: block; color: #fff; text-decoration: none; background: #000; }
  #map :global(.pop-img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  #map :global(.pop-body) { position: absolute; inset: auto 0 0; padding: 2.5rem 0.85rem 0.75rem; background: linear-gradient(transparent, rgb(0 0 0 / 0.8) 45%); }
  #map :global(.pop-kicker) { display: flex; align-items: center; gap: 0.4rem; font: 600 0.8rem/1.2 var(--display); color: var(--sand); }
  #map :global(.pop-dot) { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 1.5px #fff; }
  #map :global(.pop-title) { display: block; margin: 0.3rem 0; font: 850 1.5rem/0.95 var(--display); font-stretch: 62%; text-transform: uppercase; }
  #map :global(.pop-date) { display: block; font: 0.8rem/1.3 var(--display); color: #e8e6de; }
  #map :global(.pop:focus-visible) { outline: 3px solid var(--sand); outline-offset: -3px; }
</style>
